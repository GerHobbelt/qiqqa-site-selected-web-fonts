}

div.fira-code-font {
	font-family: 'Fira Code VF', var(--font-showcase-fallback-font-1), var(--font-showcase-fallback-font-2);
	font-weight: 400;
	overflow-x: hidden;

  font-weight: var(--text-weight);
  font-stretch: var(--text-width);
