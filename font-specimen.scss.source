

:root {
  --text-width: 100%;
  --text-weight: 400;
  --text-size: 32px;

  --text-volm: 100;
  --text-flar: 20;
  --text-opsz: 100;
  --text-wdth: var(--text-width);
  --text-ital: 10;
  --text-slnt: -10;

  /* this dot-matrix printer font shows up in entries which do not correctly reference their custom font... */
  --font-showcase-fallback-font-1: 'Redacted VF';
  --font-showcase-fallback-font-2: 'Last Resort';
  
  --background-warning-color: white;
}



article {
  margin: 0 auto;
  max-width: 76vw;
  padding: 1em;
}
html {
    background-color: var(--background-warning-color);
}
body {
    background-color: #fffffff5;
    margin: 1em;
}
h1 {
  font-size: calc(1.2 * var(--text-size));
}
p {
  font-size: var(--text-size);
  padding: 0 1em;
  line-height: 1.5em;
}
.glyph {
  margin: 1em auto;
  text-align: center;
  font-size: calc(2.5 * var(--text-size));
}

pre {
  font-family: inherit;
}
h1, .glyph {
  font-family: inherit;
}
p {
  font-family: inherit;
}
    
.showcase-another-font {
}

hr {
  border: solid red 1em;
}

.dig-normal {
  font-variant-numeric: normal;
}
.dig-ordinal {
  font-variant-numeric: ordinal;
}
.dig-slashed {
  font-variant-numeric: slashed-zero;
}
.dig-lining {
  font-variant-numeric: lining-nums;         /* <numeric-figure-values> */
}
.dig-oldstyle {
  font-variant-numeric: oldstyle-nums;       /* <numeric-figure-values> */
}
.dig-proportional {
  font-variant-numeric: proportional-nums;   /* <numeric-spacing-values> */
}
.dig-tabular {
  font-variant-numeric: tabular-nums;        /* <numeric-spacing-values> */
}


@media (max-width: 640px) {
  p {
    padding: 0;
    font-size: calc(0.75 * var(--text-size));
  }
}


.code {
  font-feature-settings: "calt" 1;  /* Enable ligatures for IE 10+, Edge */
  text-rendering: optimizeLegibility; /* Force ligatures for Webkit, Blink, Gecko */
  width: 30em;
  margin: 5em auto;
  white-space: pre-wrap;
  word-break: break-all;
}
.thin { font-weight: 100; }
.ultralight { font-weight: 200; }
.light { font-weight: 300; }
.regular { font-weight: 400; }
.medium { font-weight: 500; }
.semibold { font-weight: 600; }
.bold { font-weight: 700; }
.extrabold { font-weight: 800; }
.black { font-weight: 900; }
.variable { 
  font-weight: var(--text-weight);
  font-stretch: var(--text-width);
  font-size: var(--text-size);
  line-height: 1.5em;
}
i { font-style: italic; color: #c33; }
b { font-weight: calc(1.5 * var(--text-weight)); color: #c33; }


h2 {
    border-top: solid 3px red;
    padding-top: .5em;
    border-bottom: solid 1px red;
    padding-bottom: .2em;
    margin-top: 3em;
    margin-bottom: 2em;
}







div.firacode-font { 
	font-family: "Fira Code VF", var(--font-showcase-fallback-font-1), var(--font-showcase-fallback-font-2); 
    line-height: 1.5em;
}


















div.fira-font {
